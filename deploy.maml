{
  import: ["recipe/common.php"]

  config: {
    repository: "git@github.com:magicoli/taxesejour-bridge.git",
    keep_releases: 3,
    shared_files: ["config.toml"],
    shared_dirs: [".venv", "data"]
  }

  hosts: {
    "bokit.click": {
      remote_user: "magic"
      deploy_path: "/opt/taxesejour-bridge"
      branch: "master"
    }
  }

  tasks: {
    "deploy:venv": [
      { desc: "Create virtualenv and install dependencies" }
      { run: "[ -f {{deploy_path}}/shared/.venv/bin/activate ] || python3 -m venv {{deploy_path}}/shared/.venv" }
      { run: "{{deploy_path}}/shared/.venv/bin/pip install --quiet -r {{release_path}}/requirements.txt" }
    ]
  }

  after: {
    "deploy:shared": "deploy:venv"
    "deploy:failed": "deploy:unlock"
  }
}
